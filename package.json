{
  "name": "nimbus-web-clipper",
  "displayName": "Nimbus Web Clipper",
  "description": "Clip articles and selections from the browser into your local-first Nimbus index.",
  "version": "0.2.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimbus-agent/nimbus-web-clipper"
  },
  "bugs": {
    "url": "https://github.com/nimbus-agent/nimbus-web-clipper/issues"
  },
  "homepage": "https://nimbus-agent.dev/user-guide/web-clipper/",
  "scripts": {
    "build": "bun esbuild.mjs",
    "watch": "bun esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bunx vitest run",
    "test:coverage": "bunx vitest run --coverage",
    "check-build": "bun scripts/check-build.mjs",
    "package": "bun scripts/package.mjs",
    "clean": "bun scripts/clean.mjs",
    "mock-gateway": "bun scripts/screenshots/mock-gateway.ts",
    "screenshots:setup": "playwright install chromium",
    "screenshots": "node scripts/screenshots/capture.ts",
    "promo": "node scripts/gen-promo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@mozilla/readability": "^0.6.0",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-webstore-upload-cli": "^4.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0"
  }
}
